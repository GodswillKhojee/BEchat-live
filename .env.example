# -----------------------------------------------------------------------------
# ChatLive Environment Configuration Template
# NOTE: Copy this file to .env and replace placeholder values with your secrets.
# NEVER commit .env files with real credentials to version control!
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/chatlive

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=1d

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Optional: Redis Configuration (for horizontal scaling with Socket.IO Redis Adapter)
# REDIS_URL=redis://localhost:6379
